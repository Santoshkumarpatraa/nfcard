# Copy to .env.local for development. Every value below is a placeholder.

# Public site URL. Burned into NFC chips as <url>/t/<code>, so production must use the final domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# Postgres. Development falls back to postgres://localhost:5432/nfcard_local when unset.
DATABASE_URL=postgres://localhost:5432/nfcard_local

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3400

# OTP delivery: "console" logs codes to the terminal (default outside production), "live" sends real SMS and email.
OTP_DELIVERY=console

# MSG91 SMS (India, DLT-registered OTP template)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# Resend email
RESEND_API_KEY=
EMAIL_FROM="NFCard <hello@example.com>"

# Media storage: "local" writes to ./.uploads served via /media (dev only), "s3" uploads to an S3-compatible bucket such as R2.
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base for the bucket, e.g. https://media.example.com. Leave empty with the local driver.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Razorpay (use test keys until KYC is complete)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
